# ── Superset ──────────────────────────────────────────────────────────────────
SUPERSET_URL=https://sider.der.pe.gov.br/analytics
SUPERSET_USER=usuario_servico
SUPERSET_PASSWORD=
SUPERSET_DATABASE_NAME=BI-PRO-CONSULTA
SUPERSET_VERIFY_SSL=true

# ── PostgreSQL (metadados do portal) ──────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=derpe_portal
POSTGRES_USER=derpe
POSTGRES_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
CACHE_TTL=3600

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
CORS_ORIGINS=http://localhost:8080

# ── Admin inicial (criado automaticamente na primeira execução) ───────────────
ADMIN_EMAIL=admin@der.pe.gov.br
ADMIN_PASSWORD=
